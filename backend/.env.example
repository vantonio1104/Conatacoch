# Copia este archivo como .env (solo para probar en tu PC). En Render se configuran en "Environment".
# Cadena de conexión de Neon (Dashboard > Connect). Debe terminar en ?sslmode=require
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Cadena de conexión de MongoDB Atlas (Connect > Drivers)
MONGODB_URI=mongodb+srv://usuario:clave@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=conatacoch
# Texto largo y secreto para firmar las sesiones
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto
PORT=3000
