{
  "name": "conatacoch-backend",
  "version": "1.1.0",
  "description": "Backend REST + WebSocket para CONATACOCH (PostgreSQL + MongoDB)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node db/init.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:carga": "node test/carga.js",
    "test:e2e": "playwright test --config test/e2e/playwright.config.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "autocannon": "^7.15.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  }
}
